---
interface FaqItem {
  question: string;
  answer: string;
}

interface FaqCategory {
  name: string;
  items: FaqItem[];
}

interface Props {
  categories: FaqCategory[];
}

const { categories } = Astro.props;
---

<div x-data="{ activeTab: 0, openItem: null }">
  <!-- Tab kategori -->
  <div class="flex flex-wrap gap-2 mb-8" role="tablist" aria-label="Kategori FAQ">
    {categories.map((cat, i) => (
      <button
        type="button"
        role="tab"
        @click={`activeTab = ${i}; openItem = null`}
        :aria-selected={`activeTab === ${i}`}
        :class={`activeTab === ${i}
          ? 'bg-indigo text-white border-indigo'
          : 'bg-transparent text-ink border-mist hover:border-indigo'`}
        class="px-5 py-2 text-sm font-medium border rounded-full transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-gold focus-visible:outline-offset-2"
      >
        {cat.name}
      </button>
    ))}
  </div>

  <!-- Daftar FAQ per kategori -->
  {categories.map((cat, catIdx) => (
    <div
      x-show={`activeTab === ${catIdx}`}
      x-transition:enter="transition ease-out duration-150"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      role="tabpanel"
      class="space-y-3"
    >
      {cat.items.map((item, itemIdx) => (
        <div
          class="border border-mist rounded-[--radius-accordion] overflow-hidden bg-paper"
        >
          <button
            type="button"
            @click={`openItem = openItem === '${catIdx}-${itemIdx}' ? null : '${catIdx}-${itemIdx}'`}
            :aria-expanded={`openItem === '${catIdx}-${itemIdx}'`}
            class="w-full flex items-center justify-between gap-4 p-5 text-left hover:bg-mist/30 transition-colors focus-visible:outline-2 focus-visible:outline-gold focus-visible:outline-offset-[-2px]"
          >
            <span class="font-display text-base lg:text-lg font-medium text-ink">
              {item.question}
            </span>
            <span
              class="flex-shrink-0 w-6 h-6 flex items-center justify-center text-ink transition-transform duration-200"
              :class={`openItem === '${catIdx}-${itemIdx}' ? 'rotate-45' : ''`}
              aria-hidden="true"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </span>
          </button>

          <div
            x-show={`openItem === '${catIdx}-${itemIdx}'`}
            x-collapse
            class="overflow-hidden"
          >
            <div class="px-5 pb-5 text-ink/80 leading-relaxed">
              {item.answer}
            </div>
          </div>
        </div>
      ))}
    </div>
  ))}
</div>