---
// ProgramCard.astro — versi dirapikan
// Perubahan utama: hapus gradient overlay di atas gambar, hapus "glass badge"
// ikon yang melayang, dan batasi warna aksen jadi satu (indigo) per kartu
// supaya tidak bentrok dengan gold (badge) dan vermillion (CTA utama di halaman).
import * as icons from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  image?: string;
  badge?: string;
  iconName?: string;
}

const { title, description, slug, image, badge, iconName } = Astro.props;

const IconComponent = iconName
  ? (icons as Record<string, any>)[iconName] ?? icons.BookOpen
  : icons.BookOpen;
---

<a
  href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/program/${slug}`}
  class="group flex flex-col bg-paper border border-mist rounded-[--radius-card] overflow-hidden shadow-sm transition-all duration-300 ease-out hover:border-indigo hover:shadow-xl hover:-translate-y-1.5 focus-visible:outline-2 focus-visible:outline-gold focus-visible:outline-offset-2"
>
  <!-- Gambar -->
  <div class="relative aspect-[16/10] overflow-hidden bg-mist">
    {image ? (
      <img
        src={image}
        alt={`Foto kelas ${title}`}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-mist">
        <IconComponent class="w-12 h-12 text-indigo/30" stroke-width={1.5} />
      </div>
    )}

    {badge && (
      <span class="absolute top-3 left-3 inline-flex items-center bg-gold text-ink text-xs font-medium px-2.5 py-1 rounded-md">
        {badge}
      </span>
    )}
  </div>

  <!-- Konten -->
  <div class="flex-1 flex flex-col p-5">
    <div class="flex items-center gap-2">
      <IconComponent class="w-4 h-4 text-indigo flex-shrink-0" stroke-width={2} aria-hidden="true" />
      <h3 class="font-display text-lg font-medium text-ink leading-snug">
        {title}
      </h3>
    </div>
    <p class="mt-2 text-sm text-ink/70 leading-relaxed flex-1">
      {description}
    </p>

    <div class="mt-4 pt-4 border-t border-mist flex items-center gap-1.5 text-sm font-medium text-indigo">
      Pelajari Kurikulum & Biaya
      <svg
        class="w-4 h-4 transition-transform duration-150 group-hover:translate-x-1"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </div>
</a>