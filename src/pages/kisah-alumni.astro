---
// src/pages/kisah-alumni.astro — Testimoni & Kisah Sukses
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import VideoCarousel from '../components/VideoCarousel.astro';

// Ambil semua testimonials, pisahkan teks vs video
const allTestimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order
);

const textTestimonials = allTestimonials.filter((t) => t.data.type === 'text');
const videoTestimonials = allTestimonials.filter((t) => t.data.type === 'video');

// Siapkan data video untuk VideoCarousel
const videos = videoTestimonials.map((t) => ({
  id: t.id,
  name: t.data.name,
  city: t.data.city,
  poster: t.data.poster ?? '',
  videoUrl: t.data.videoUrl ?? '',
}));
---

<BaseLayout
  title="Kisah Alumni"
  description="100+ alumni HATESE kini bekerja di berbagai kota di Jepang — dari Okinawa sampai Kagoshima. Baca dan tonton kisah mereka."
>
  <!-- ============ HERO ============ -->
  <section class="bg-indigo text-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold leading-[1.05]">
          Mereka Sudah Berangkat. <br class="hidden sm:block" />
          <span class="text-gold">Kamu Berikutnya.</span>
        </h1>
        <p class="mt-6 text-lg text-paper/80 leading-relaxed max-w-[60ch]">
          100+ alumni HATESE kini bekerja di berbagai kota di Jepang — dari Okinawa sampai Kagoshima. Ini kisah mereka, dalam kata dan gambar.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONI TEKS ============ -->
  {textTestimonials.length > 0 && (
    <section class="bg-paper">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
        <div class="max-w-2xl mb-12">
          <h2 class="font-display text-3xl lg:text-4xl font-semibold text-ink">
            Kata Mereka
          </h2>
          <p class="mt-4 text-lg text-ink/70">
            Pengalaman langsung dari alumni yang sudah bekerja di Jepang.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {textTestimonials.map((t) => (
            <TestimonialCard
              name={t.data.name}
              city={t.data.city ?? '-'}
              company={t.data.company}
              quote={t.data.quote}
              photo={t.data.photo}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ TESTIMONI VIDEO ============ -->
  {videos.length > 0 && (
    <section class="bg-mist/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
        <div class="max-w-2xl mb-12">
          <h2 class="font-display text-3xl lg:text-4xl font-semibold text-ink">
            Cerita dalam Video
          </h2>
          <p class="mt-4 text-lg text-ink/70">
            Dengar langsung dari alumni tentang kehidupan dan pekerjaan mereka di Jepang.
          </p>
        </div>

        <VideoCarousel videos={videos} />
      </div>
    </section>
  )}

  <!-- ============ STATISTIK ALUMNI ============ -->
  <section class="bg-paper border-t border-mist">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="grid sm:grid-cols-3 gap-8 lg:gap-12">
        <div class="text-center sm:text-left">
          <p class="font-display text-4xl lg:text-5xl font-semibold text-indigo">
            100+
          </p>
          <p class="mt-2 text-sm lg:text-base text-ink/70">
            Alumni Berangkat ke Jepang
          </p>
        </div>
        <div class="text-center sm:text-left">
          <p class="font-display text-4xl lg:text-5xl font-semibold text-indigo">
            20+
          </p>
          <p class="mt-2 text-sm lg:text-base text-ink/70">
            Kota di Jepang Jadi Tempat Kerja
          </p>
        </div>
        <div class="text-center sm:text-left">
          <p class="font-display text-4xl lg:text-5xl font-semibold text-indigo">
            14
          </p>
          <p class="mt-2 text-sm lg:text-base text-ink/70">
            Bidang Kerja SSW yang Terwakili
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA PENUTUP ============ -->
  <section class="bg-indigo text-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 text-center">
      <h2 class="font-display text-3xl lg:text-4xl font-semibold">
        Tertarik Bekerja Profesional di Jepang?
      </h2>
      <p class="mt-4 text-lg text-paper/80 max-w-[52ch] mx-auto">
        Konsultasi gratis dulu — tim kami akan menjelaskan alur, biaya, dan peluang yang paling cocok untukmu.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button variant="primary" href="/daftar" iconRight>
          Konsultasi Sekarang
        </Button>
        <a href="/karier" class="inline-flex items-center gap-2 px-5 py-2.5 text-paper border-[1.5px] border-paper/40 rounded-[--radius-button] hover:bg-paper/10 transition-colors">
          Lihat Bidang Kerja
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SCROLL REVEAL (fade-in ketika di-scroll) ============ -->
  <style>
    section.js-reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    section.js-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      section.js-reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script>
    function initScrollReveal() {
      const sections = document.querySelectorAll('section');
      if (!sections.length) return;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      sections.forEach((el) => el.classList.add('js-reveal'));

      if (prefersReduced || !('IntersectionObserver' in window)) {
        sections.forEach((el) => el.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );

      sections.forEach((el) => observer.observe(el));
    }

    // Jalankan saat load pertama, dan saat navigasi lewat Astro View Transitions (jika dipakai)
    initScrollReveal();
    document.addEventListener('astro:page-load', initScrollReveal);
  </script>
</BaseLayout>