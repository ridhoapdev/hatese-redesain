<!-- ============ HERO LOAD ANIMATION ============ -->
<script>
  import { animate, inView, stagger } from "motion";

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  if (!prefersReduced) {
    const copy = document.querySelector(".js-hero-copy");
    const image = document.querySelector(".js-hero-image");
    const cta = document.querySelector(".js-hero-cta");

    if (copy || image) {
      animate(
        [copy, image].filter(Boolean) as Element[],
        { opacity: [0, 1], y: [16, 0] },
        { duration: 0.6, delay: stagger(0.12), ease: "easeOut" },
      );
    }
    if (cta) {
      animate(
        cta,
        { opacity: [0, 1], y: [12, 0] },
        { duration: 0.5, delay: 0.4, ease: "easeOut" },
      );
    }
  }

  // ============ FADE-IN SAAT SCROLL ============
  // Elemen ".reveal" fade + geser naik satu-satu ketika masuk viewport.
  // Elemen ".reveal-item" di dalam ".reveal-group" muncul bertahap (stagger)
  // begitu grid-nya mulai terlihat.
  const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
  const revealGroups = document.querySelectorAll<HTMLElement>(".reveal-group");

  if (prefersReduced) {
    revealEls.forEach((el) => (el.style.opacity = "1"));
    revealGroups.forEach((group) =>
      group
        .querySelectorAll<HTMLElement>(".reveal-item")
        .forEach((el) => (el.style.opacity = "1")),
    );
  } else {
    revealEls.forEach((el) => {
      inView(
        el,
        () => {
          animate(
            el,
            { opacity: [0, 1], y: [24, 0] },
            { duration: 0.6, ease: "easeOut" },
          );
        },
        { amount: 0.2 },
      );
    });

    revealGroups.forEach((group) => {
      const items = group.querySelectorAll<HTMLElement>(".reveal-item");
      if (items.length === 0) return;
      inView(
        group,
        () => {
          animate(
            Array.from(items),
            { opacity: [0, 1], y: [20, 0] },
            { duration: 0.5, delay: stagger(0.08), ease: "easeOut" },
          );
        },
        { amount: 0.15 },
      );
    });
  }

  // ============ ANGKA BERJALAN (COUNT-UP) ============
  // Elemen dengan [data-counter-target] dihitung naik dari 0 sampai
  // nilai aslinya, dipicu sekali saat pertama kali terlihat di layar.
  const counters = document.querySelectorAll<HTMLElement>(
    "[data-counter-target]",
  );

  const formatCounter = (value: number, prefix: string, suffix: string) =>
    `${prefix}${Math.floor(value).toLocaleString("id-ID")}${suffix}`;

  counters.forEach((el) => {
    const target = Number(el.dataset.counterTarget ?? "0");
    const prefix = el.dataset.counterPrefix ?? "";
    const suffix = el.dataset.counterSuffix ?? "";

    if (prefersReduced) {
      el.textContent = formatCounter(target, prefix, suffix);
      return;
    }

    const stopWatching = inView(
      el,
      () => {
        animate(0, target, {
          duration: 1.8,
          ease: "easeOut",
          onUpdate: (latest) => {
            el.textContent = formatCounter(latest, prefix, suffix);
          },
        });
        stopWatching();
      },
      { amount: 0.6 },
    );
  });
</script>