---
// src/pages/daftar.astro — Formulir Pendaftaran / Konsultasi
import * as icons from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// ===== Bidang kerja untuk dropdown =====
const careerOptions = [
  'Belum tahu, ingin konsultasi dulu',
  'Food Service (Restoran & Kuliner)',
  'Perawatan Lansia (Kaigo)',
  'Konstruksi',
  'Manufaktur & Perakitan Mesin',
  'Perhotelan (Akomodasi)',
  'Pertanian',
  'Perikanan',
  'Pengolahan Makanan & Minuman',
  'Kebersihan Gedung',
  'Perawatan Kendaraan (Otomotif)',
  'Industri Perkapalan',
  'Elektro & Elektronik',
  'Perawatan Pesawat (Aviasi)',
  'Layanan Publik & Lainnya',
];

// ===== Program kelas untuk dropdown =====
const programOptions = [
  'Belum tahu, ingin rekomendasi',
  'Kelas Reguler (Offline)',
  'Kelas Online via Zoom',
  'Kelas Online Berbasis LMS (Coming Soon)',
  'Kelas Karyawan',
  'Kelas Pemantapan JFT & SSW',
];

// ===== Alasan / trust signals =====
const trustSignals = [
  {
    iconName: 'ShieldCheck',
    title: 'Data Anda Aman',
    body: 'Kami tidak membagikan data Anda ke pihak ketiga tanpa izin.',
  },
  {
    iconName: 'MessageCircle',
    title: 'Dibalas Cepat',
    body: 'Tim kami merespons dalam 1×24 jam di hari kerja.',
  },
  {
    iconName: 'Users',
    title: 'Konsultasi Gratis',
    body: 'Tidak ada biaya, tidak ada komitmen. Murni untuk membantu Anda.',
  },
];

const trustSignalIcons = {
  ShieldCheck: icons.ShieldCheck,
  MessageCircle: icons.MessageCircle,
  Users: icons.Users,
};
---

<BaseLayout
  title="Daftar & Konsultasi"
  description="Konsultasi gratis dengan tim HATESE — jelaskan tujuan dan kesibukanmu, kami akan merekomendasikan kelas dan bidang kerja yang paling cocok."
>
  <!-- ============ HERO ============ -->
  <section class="bg-indigo text-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="max-w-3xl">
        <nav class="mb-6 text-sm text-paper/60" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:text-gold transition-colors">Beranda</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-paper">Daftar & Konsultasi</li>
          </ol>
        </nav>

        <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-[1.05]">
          Mulai dari <span class="text-gold">Konsultasi Gratis.</span>
        </h1>
        <p class="mt-6 text-lg text-paper/80 leading-relaxed max-w-[60ch]">
          Isi formulir di bawah ini — tim HATESE akan menghubungi Anda lewat WhatsApp untuk menjelaskan alur, biaya, dan peluang yang paling cocok. Tanpa biaya, tanpa komitmen.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FORM + SIDEBAR ============ -->
  <section class="bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid lg:grid-cols-3 gap-10 lg:gap-12">

        <!-- ===== FORMULIR (kolom utama) ===== -->
        <div class="lg:col-span-2">
          <form
            action="/api/daftar"
            method="POST"
            class="bg-paper border border-mist rounded-[--radius-card] p-6 lg:p-8 space-y-6"
            x-data="{
              submitting: false,
              submitted: false,
              error: '',
              onSubmit(e) {
                this.submitting = true;
                this.error = '';
              }
            }"
            @submit="onSubmit"
          >
            <!-- Status success (ditampilkan via JS setelah submit berhasil) -->
            <div
              x-show="submitted"
              x-cloak
              x-transition:enter="transition ease-out duration-300"
              class="bg-success/10 border border-success/30 rounded-[--radius-card] p-6 text-center"
            >
              <icons.CheckCircle class="w-12 h-12 text-success mx-auto" stroke-width={1.5} />
              <h2 class="mt-3 font-display text-xl font-medium text-ink">
                Terima kasih!
              </h2>
              <p class="mt-2 text-ink/70">
                Formulir Anda sudah kami terima. Tim HATESE akan menghubungi Anda lewat WhatsApp dalam 1×24 jam.
              </p>
            </div>

            <!-- Fieldset utama -->
            <fieldset x-show="!submitted" class="space-y-6">

              <!-- Nama lengkap -->
              <div>
                <label for="nama" class="block text-sm font-medium text-ink mb-2">
                  Nama Lengkap <span class="text-vermillion">*</span>
                </label>
                <input
                  type="text"
                  id="nama"
                  name="nama"
                  required
                  autocomplete="name"
                  placeholder="Contoh: Ahmad Rizki Pratama"
                  class="w-full px-4 py-3 bg-paper border border-mist rounded-[--radius-button] text-ink placeholder:text-ink/40 focus:border-indigo focus:ring-2 focus:ring-indigo/20 focus:outline-none transition-colors"
                />
              </div>

              <!-- WhatsApp + Usia -->
              <div class="grid sm:grid-cols-2 gap-6">
                <div>
                  <label for="whatsapp" class="block text-sm font-medium text-ink mb-2">
                    Nomor WhatsApp <span class="text-vermillion">*</span>
                  </label>
                  <input
                    type="tel"
                    id="whatsapp"
                    name="whatsapp"
                    required
                    autocomplete="tel"
                    inputmode="numeric"
                    pattern="[0-9+\-\s]{10,16}"
                    placeholder="0812-3456-7890"
                    class="w-full px-4 py-3 bg-paper border border-mist rounded-[--radius-button] text-ink placeholder:text-ink/40 focus:border-indigo focus:ring-2 focus:ring-indigo/20 focus:outline-none transition-colors"
                  />
                  <p class="mt-1.5 text-xs text-ink/50">
                    Kami akan menghubungi Anda lewat nomor ini.
                  </p>
                </div>

                <div>
                  <label for="usia" class="block text-sm font-medium text-ink mb-2">
                    Usia <span class="text-vermillion">*</span>
                  </label>
                  <input
                    type="number"
                    id="usia"
                    name="usia"
                    required
                    min="17"
                    max="45"
                    placeholder="Contoh: 22"
                    class="w-full px-4 py-3 bg-paper border border-mist rounded-[--radius-button] text-ink placeholder:text-ink/40 focus:border-indigo focus:ring-2 focus:ring-indigo/20 focus:outline-none transition-colors"
                  />
                </div>
              </div>

              <!-- Domisili -->
              <div>
                <label for="domisili" class="block text-sm font-medium text-ink mb-2">
                  Kota/Kabupaten Domisili <span class="text-vermillion">*</span>
                </label>
                <input
                  type="text"
                  id="domisili"
                  name="domisili"
                  required
                  autocomplete="address-level2"
                  placeholder="Contoh: Cirebon"
                  class="w-full px-4 py-3 bg-paper border border-mist rounded-[--radius-button] text-ink placeholder:text-ink/40 focus:border-indigo focus:ring-2 focus:ring-indigo/20 focus:outline-none transition-colors"
                />
              </div>

              <!-- Email (opsional) -->
              <div>
                <label for="email" class="block text-sm font-medium text-ink mb-2">
                  Email <span class="text-ink/40 text-xs font-normal">(opsional)</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  autocomplete="email"
                  placeholder="nama@email.com"
                  class="w-full px-4 py-3 bg-paper border border-mist rounded-[--radius-button] text-ink placeholder:text-ink/40 focus:border-indigo focus:ring-2 focus:ring-indigo/20 focus:outline-none transition-colors"
                />
              </div>

              <!-- Bidang kerja yang diminati -->
              <div>
                <label for="bidang" class="block text-sm font-medium text-ink mb-2">
                  Bidang Kerja yang Diminati <span class="text-vermillion">*</span>
                </label>
                <select
                  id="bidang"
                  name="bidang"
                  required
                  class="w-full px-4 py-3 bg-paper border border-mist rounded-[--radius-button] text-ink focus:border-indigo focus:ring-2 focus:ring-indigo/20 focus:outline-none transition-colors appearance-none bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2224%22 height=%2224%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%231C2029%22 stroke-width=%222%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><polyline points=%226 9 12 15 18 9%22/></svg>')] bg-[length:20px] bg-[right_12px_center] bg-no-repeat pr-12"
                >
                  {careerOptions.map((opt) => (
                    <option value={opt}>{opt}</option>
                  ))}
                </select>
              </div>

              <!-- Program kelas -->
              <div>
                <label for="program" class="block text-sm font-medium text-ink mb-2">
                  Program Kelas yang Diminati
                </label>
                <select
                  id="program"
                  name="program"
                  class="w-full px-4 py-3 bg-paper border border-mist rounded-[--radius-button] text-ink focus:border-indigo focus:ring-2 focus:ring-indigo/20 focus:outline-none transition-colors appearance-none bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2224%22 height=%2224%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%231C2029%22 stroke-width=%222%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><polyline points=%226 9 12 15 18 9%22/></svg>')] bg-[length:20px] bg-[right_12px_center] bg-no-repeat pr-12"
                >
                  {programOptions.map((opt) => (
                    <option value={opt}>{opt}</option>
                  ))}
                </select>
              </div>

              <!-- Pesan tambahan -->
              <div>
                <label for="pesan" class="block text-sm font-medium text-ink mb-2">
                  Ada pertanyaan atau catatan khusus?
                </label>
                <textarea
                  id="pesan"
                  name="pesan"
                  rows="4"
                  placeholder="Contoh: Saya sudah punya dasar bahasa Jepang N5, apakah bisa langsung ikut kelas pemantapan?"
                  class="w-full px-4 py-3 bg-paper border border-mist rounded-[--radius-button] text-ink placeholder:text-ink/40 focus:border-indigo focus:ring-2 focus:ring-indigo/20 focus:outline-none transition-colors resize-y"
                ></textarea>
              </div>

              <!-- Persetujuan -->
              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="setuju"
                  name="setuju"
                  required
                  class="mt-1 w-4 h-4 rounded border-mist text-indigo focus:ring-2 focus:ring-indigo/30"
                />
                <label for="setuju" class="text-sm text-ink/70 leading-relaxed">
                  Saya setuju data yang saya isi digunakan oleh tim HATESE untuk keperluan konsultasi.
                </label>
              </div>

              <!-- Submit -->
              <div class="pt-2">
                <button
                  type="submit"
                  :disabled="submitting"
                  class="inline-flex items-center justify-center gap-2 bg-vermillion text-white px-6 py-3 rounded-[--radius-button] font-medium hover:bg-vermillion-hover hover:-translate-y-px transition-all duration-150 disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-gold focus-visible:outline-offset-2"
                >
                  <span x-show="!submitting">Kirim & Konsultasi Gratis</span>
                  <span x-show="submitting" x-cloak class="inline-flex items-center gap-2">
                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Mengirim...
                  </span>
                  <svg x-show="!submitting" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </button>
              </div>
            </fieldset>
          </form>

          <!-- TODO: buat endpoint /api/daftar untuk handle submit -->
          <!-- Sementara form mengarah ke /api/daftar yang belum ada -->
          <!-- Opsi: pakai layanan pihak ketiga (Formspree, Netlify Forms, Google Forms) -->
        </div>

        <!-- ===== SIDEBAR (trust signals + kontak langsung) ===== -->
        <aside class="lg:col-span-1 space-y-6">

          <!-- Trust signals -->
          <div class="bg-mist/40 border border-mist rounded-[--radius-card] p-6">
            <h2 class="font-display text-lg font-medium text-ink mb-4">
              Kenapa Konsultasi Dulu?
            </h2>
            <ul class="space-y-4">
              {trustSignals.map((item) => {
                const IconComponent = trustSignalIcons[item.iconName as keyof typeof trustSignalIcons] ?? icons.Star;
                return (
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-9 h-9 rounded-[--radius-card] bg-paper border border-mist text-indigo flex items-center justify-center">
                      <IconComponent class="w-4 h-4" stroke-width={2} />
                    </span>
                    <div>
                      <p class="font-medium text-ink text-sm">{item.title}</p>
                      <p class="text-xs text-ink/60 mt-0.5 leading-relaxed">{item.body}</p>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- Kontak langsung -->
          <div class="bg-indigo text-paper rounded-[--radius-card] p-6">
            <h2 class="font-display text-lg font-medium mb-2">
              Lebih Suka Langsung?
            </h2>
            <p class="text-sm text-paper/75 leading-relaxed mb-5">
              Hubungi kami lewat WhatsApp atau telepon — tim kami siap membantu di jam kerja.
            </p>

            <div class="space-y-3">
              <a
                href="https://wa.me/6281234567890?text=Halo%20HATESE%2C%20saya%20ingin%20konsultasi%20tentang%20program%20kerja%20ke%20Jepang."
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 w-full bg-paper/10 hover:bg-paper/20 rounded-[--radius-button] px-4 py-3 transition-colors"
              >
                <icons.MessageCircle class="w-5 h-5 text-gold flex-shrink-0" stroke-width={1.75} />
                <span class="text-sm font-medium">WhatsApp</span>
              </a>

              <a
                href="tel:+6281234567890"
                class="flex items-center gap-3 w-full bg-paper/10 hover:bg-paper/20 rounded-[--radius-button] px-4 py-3 transition-colors"
              >
                <icons.Phone class="w-5 h-5 text-gold flex-shrink-0" stroke-width={1.75} />
                <span class="text-sm font-medium">Telepon</span>
              </a>

              <a
                href="mailto:info@hatese.co.id"
                class="flex items-center gap-3 w-full bg-paper/10 hover:bg-paper/20 rounded-[--radius-button] px-4 py-3 transition-colors"
              >
                <icons.Mail class="w-5 h-5 text-gold flex-shrink-0" stroke-width={1.75} />
                <span class="text-sm font-medium">Email</span>
              </a>
            </div>

            <p class="mt-5 text-xs text-paper/60">
              Jam operasional: Senin–Sabtu, 08.00–17.00 WIB
            </p>

            <!-- TODO: ganti nomor WA & email dengan data resmi HATESE -->
          </div>

          <!-- Alamat -->
          <div class="bg-paper border border-mist rounded-[--radius-card] p-6">
            <h2 class="font-display text-base font-medium text-ink mb-3">
              Kantor Kami
            </h2>
            <div class="flex items-start gap-3">
              <icons.MapPin class="w-5 h-5 text-indigo flex-shrink-0 mt-0.5" stroke-width={1.75} />
              <p class="text-sm text-ink/70 leading-relaxed">
                Kota Cirebon, Jawa Barat, Indonesia
                <!-- TODO: isi alamat lengkap -->
              </p>
            </div>
            <a
              href="/tentang"
              class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-vermillion hover:gap-2.5 transition-all"
            >
              Lihat peta lokasi
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============ FAQ SINGKAT ============ -->
  <section class="bg-mist/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="text-center mb-10">
        <h2 class="font-display text-2xl lg:text-3xl font-semibold text-ink">
          Pertanyaan yang Mungkin Muncul
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        {[
          { q: 'Apakah konsultasi benar-benar gratis?', a: 'Ya, 100% gratis. Kami tidak meminta biaya apapun untuk sesi konsultasi awal.' },
          { q: 'Apakah harus langsung mendaftar setelah konsultasi?', a: 'Tidak. Konsultasi hanya untuk menjelaskan — keputusan sepenuhnya milik Anda.' },
          { q: 'Berapa lama sampai dihubungi?', a: 'Tim HATESE merespons dalam 1×24 jam di hari kerja.' },
          { q: 'Bagaimana kalau saya belum bisa bahasa Jepang?', a: 'Tidak masalah. Kelas kami dirancang untuk pemula total, dari nol.' },
        ].map((item) => (
          <div class="bg-paper border border-mist rounded-[--radius-card] p-5">
            <h3 class="font-display text-base font-medium text-ink">
              {item.q}
            </h3>
            <p class="mt-2 text-sm text-ink/70 leading-relaxed">
              {item.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SCROLL REVEAL (fade-in ketika di-scroll) ============ -->
  <style>
    section.js-reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    section.js-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      section.js-reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script>
    function initScrollReveal() {
      const sections = document.querySelectorAll('section');
      if (!sections.length) return;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      sections.forEach((el) => el.classList.add('js-reveal'));

      if (prefersReduced || !('IntersectionObserver' in window)) {
        sections.forEach((el) => el.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );

      sections.forEach((el) => observer.observe(el));
    }

    // Jalankan saat load pertama, dan saat navigasi lewat Astro View Transitions (jika dipakai)
    initScrollReveal();
    document.addEventListener('astro:page-load', initScrollReveal);
  </script>
</BaseLayout>