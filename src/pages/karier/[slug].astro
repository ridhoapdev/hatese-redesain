---
import { getCollection, type CollectionEntry, render } from 'astro:content';
import * as icons from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
  const careers = await getCollection('careers');
  return careers.map((career) => ({
    params: { slug: career.id },
    props: { career },
  }));
}

interface Props {
  career: CollectionEntry<'careers'>;
}

const { career } = Astro.props;
const { data } = career;
const { Content } = await render(career);

const IconComponent = (icons as Record<string, any>)[data.iconName] ?? icons.Briefcase;
---

<BaseLayout
  title={`${data.title} — Bidang Kerja di Jepang`}
  description={`Detail bidang kerja ${data.title} di Jepang: tanggung jawab, persyaratan, dan estimasi gaji ${data.salaryRange}.`}
>
  <!-- HERO -->
  <section class="bg-indigo text-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-sm text-paper/60" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href={import.meta.env.BASE_URL} class="hover:text-gold transition-colors">Beranda</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`${import.meta.env.BASE_URL}karier`} class="hover:text-gold transition-colors">Karier di Jepang</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-paper">{data.title}</li>
        </ol>
      </nav>

      <div class="flex items-start gap-5">
        <!-- Ikon Lucide dalam lingkaran -->
        <span class="flex-shrink-0 w-16 h-16 lg:w-20 lg:h-20 rounded-[--radius-card] bg-paper/10 flex items-center justify-center">
          <IconComponent class="w-8 h-8 lg:w-10 lg:h-10 text-gold" stroke-width={1.5} />
        </span>
        <div>
          <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold leading-tight">
            {data.title}
          </h1>
          <p class="mt-3 text-lg text-paper/80">
            Bidang: {data.category}
          </p>
        </div>
      </div>

      <!-- Quick stats -->
      <div class="mt-8 flex flex-wrap gap-4">
        <div class="bg-paper/10 rounded-[--radius-card] px-5 py-3">
          <p class="text-xs text-paper/60">Estimasi Gaji</p>
          <p class="font-display text-lg font-medium text-gold">{data.salaryRange}</p>
        </div>
        <div class="bg-paper/10 rounded-[--radius-card] px-5 py-3">
          <p class="text-xs text-paper/60">Status Kuota</p>
          <p class="font-display text-lg font-medium text-gold">{data.quota}</p>
        </div>
      </div>

      <!-- Gambar hero bidang (kalau ada) -->
      {data.image && (
        <div class="mt-10 aspect-[21/9] rounded-[--radius-card] overflow-hidden bg-mist">
          <img
            src={data.image}
            alt={`Ilustrasi bidang ${data.title}`}
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      )}
    </div>
  </section>

  <!-- DESKRIPSI -->
  <section class="bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="grid lg:grid-cols-3 gap-12">

        <!-- Kolom utama -->
        <div class="lg:col-span-2 space-y-12">
          <!-- Deskripsi -->
          <div>
            <h2 class="font-display text-2xl lg:text-3xl font-semibold text-ink mb-4">
              Tentang Bidang Ini
            </h2>
            <p class="text-lg text-ink/70 leading-relaxed max-w-[68ch]">
              {data.description}
            </p>
            <div class="mt-6 prose prose-slate max-w-[68ch] prose-headings:font-display prose-headings:text-ink prose-p:text-ink/70">
              <Content />
            </div>
          </div>

          <!-- Tanggung jawab -->
          <div>
            <h2 class="font-display text-2xl lg:text-3xl font-semibold text-ink mb-4">
              Apa yang Akan Kamu Kerjakan
            </h2>
            <ul class="space-y-3">
              {data.responsibilities.map((item) => (
                <li class="flex items-start gap-3 text-ink/80">
                  <svg class="w-5 h-5 text-success flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Persyaratan -->
          <div>
            <h2 class="font-display text-2xl lg:text-3xl font-semibold text-ink mb-4">
              Persyaratan
            </h2>
            <ul class="space-y-3">
              {data.requirements.map((item) => (
                <li class="flex items-start gap-3 text-ink/80">
                  <span class="w-1.5 h-1.5 rounded-full bg-vermillion flex-shrink-0 mt-2.5" aria-hidden="true"></span>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
            <p class="mt-6 text-sm text-ink/60 italic">
              Catatan: persyaratan spesifik bisa berbeda tergantung perusahaan penerima. Tim HATESE akan menjelaskan detailnya saat konsultasi.
            </p>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="sticky top-24 bg-mist/40 border border-mist rounded-[--radius-card] p-6 space-y-6">
            <div>
              <h3 class="font-display text-lg font-medium text-ink mb-2">
                Tertarik Bidang Ini?
              </h3>
              <p class="text-sm text-ink/70 leading-relaxed">
                Konsultasi gratis dulu — tim kami akan menjelaskan alur, biaya, dan peluang untuk bidang {data.title}.
              </p>
            </div>

            <Button variant="primary" href={`${import.meta.env.BASE_URL}daftar`} iconRight class="w-full">
              Konsultasi Sekarang
            </Button>

            <div class="pt-6 border-t border-mist">
              <a href={`${import.meta.env.BASE_URL}karier`} class="text-indigo hover:text-vermillion transition-colors inline-flex items-center gap-1.5 text-sm">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Lihat semua bidang kerja
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA PENUTUP -->
  <section class="bg-indigo text-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20 text-center">
      <h2 class="font-display text-3xl lg:text-4xl font-semibold">
        Siap Mulai Jalur Menuju {data.title}?
      </h2>
      <p class="mt-4 text-lg text-paper/80 max-w-[52ch] mx-auto">
        Langkah pertama adalah konsultasi — gratis, tanpa komitmen.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button variant="primary" href={`${import.meta.env.BASE_URL}daftar`} iconRight>
          Konsultasi Sekarang
        </Button>
        <a href={`${import.meta.env.BASE_URL}program`} class="inline-flex items-center gap-2 px-5 py-2.5 text-paper border-[1.5px] border-paper/40 rounded-[--radius-button] hover:bg-paper/10 transition-colors">
          Lihat Program Belajar
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SCROLL REVEAL (fade-in ketika di-scroll) ============ -->
  <style>
    section.js-reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    section.js-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      section.js-reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script>
    function initScrollReveal() {
      const sections = document.querySelectorAll('section');
      if (!sections.length) return;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      sections.forEach((el) => el.classList.add('js-reveal'));

      if (prefersReduced || !('IntersectionObserver' in window)) {
        sections.forEach((el) => el.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );

      sections.forEach((el) => observer.observe(el));
    }

    // Jalankan saat load pertama, dan saat navigasi lewat Astro View Transitions (jika dipakai)
    initScrollReveal();
    document.addEventListener('astro:page-load', initScrollReveal);
  </script>
</BaseLayout>