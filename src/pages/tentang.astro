---
// src/pages/tentang.astro — Tentang Kami
import * as icons from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const iconMap = {
  Award: icons.Award,
  BadgeCheck: icons.BadgeCheck,
  Briefcase: icons.Briefcase,
  ShieldCheck: icons.ShieldCheck,
  HeartHandshake: icons.HeartHandshake,
  Target: icons.Target,
  Star: icons.Star,
} as const;

const resolveIcon = (iconName: string) => {
  return iconMap[iconName as keyof typeof iconMap] ?? icons.Award;
};

// ===== Data Legalitas & Jaminan =====
const legalitas = [
  { label: 'Nama Resmi', value: 'PT. Harapan Terang Sejahtera' },
  { label: 'Berdiri', value: '3 Juli 2024' },
  { label: 'Lokasi', value: 'Kota Cirebon, Jawa Barat' },
  { label: 'SK Kemenkumham', value: 'No. 0047730.AH.01.01 Tahun 2023' },
];

const jaminan = [
  {
    iconName: 'Award',
    title: 'Sertifikat JFT-A2 / JLPT N4',
    body: 'Bukti resmi kemampuan bahasa Jepang yang diakui oleh perusahaan dan pemerintah Jepang.',
  },
  {
    iconName: 'BadgeCheck',
    title: 'Sertifikat SSW',
    body: 'Status visa kerja resmi untuk tenaga kerja terampil (Specified Skilled Worker).',
  },
  {
    iconName: 'Briefcase',
    title: 'Penempatan Kerja Resmi',
    body: 'Kami mencocokkan siswa dengan lowongan yang sesuai dan mendampingi sampai kontrak kerja ditandatangani.',
  },
];

// ===== Nilai / Values =====
const values = [
  {
    iconName: 'ShieldCheck',
    title: 'Transparan',
    body: 'Semua biaya, alur, dan timeline dijelaskan sejak awal. Tidak ada biaya tersembunyi, tidak ada janji kosong.',
  },
  {
    iconName: 'HeartHandshake',
    title: 'Pendampingan Penuh',
    body: 'Dari nol bahasa Jepang sampai tiba di Jepang, kami dampingi setiap tahap — bukan hanya sampai siswa bayar.',
  },
  {
    iconName: 'Target',
    title: 'Fokus Hasil',
    body: 'Target kami bukan siswa lulus ujian, tapi siswa benar-benar bekerja dan sukses di Jepang.',
  },
];
---

<BaseLayout
  title="Tentang Kami"
  description="PT. Harapan Terang Sejahtera — lembaga pelatihan kerja resmi yang membimbing tenaga kerja Indonesia ke Jepang melalui jalur sertifikasi JFT-A2/JLPT N4 dan SSW."
>
  <!-- ============ HERO ============ -->
  <section class="bg-indigo text-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Teks -->
        <div>
          <div class="flex items-center gap-2 text-sm font-medium text-gold mb-4">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span>Tentang HATESE</span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold leading-[1.05]">
            Menjembatani Mimpi, <br class="hidden sm:block" />
            <span class="text-gold">Membangun Masa Depan.</span>
          </h1>

          <p class="mt-6 text-lg text-paper/80 leading-relaxed max-w-[60ch]">
            PT. Harapan Terang Sejahtera (HATESE) adalah lembaga pelatihan kerja resmi yang berdiri 3 Juli 2024 di Kota Cirebon. Kami membimbing generasi muda Indonesia menuju karier profesional di Jepang melalui jalur sertifikasi JFT-A2/JLPT N4 dan SSW.
          </p>
        </div>

        <!-- Gambar -->
        <div class="relative">
          <!-- TODO: ganti dengan foto asli — kantor HATESE / tim / sertifikat -->
          <div class="aspect-[4/3] rounded-[--radius-card] overflow-hidden bg-indigo-deep">
            <img
              src="/images/tentang/kantor-hatese.jpg"
              alt="Kantor HATESE di Kota Cirebon"
              loading="eager"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SEJARAH ============ -->
  <section class="bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">

        <!-- Kolom kiri: heading -->
        <div>
          <h2 class="font-display text-3xl lg:text-4xl font-semibold text-ink leading-tight">
            Dari Cirebon, <br class="hidden sm:block" />
            untuk Masa Depan Indonesia.
          </h2>
        </div>

        <!-- Kolom kanan: paragraf -->
        <div class="space-y-6 text-ink/70 leading-relaxed max-w-[68ch]">
          <p class="text-lg">
            HATESE lahir dari keresahan sederhana: banyak anak muda Indonesia yang ingin bekerja ke Jepang, tetapi tidak tahu harus mulai dari mana. Informasi tersebar, biaya tidak transparan, dan banyak yang akhirnya terjebak calo atau agen tidak resmi.
          </p>
          <p>
            Kami memutuskan membangun lembaga pelatihan yang <strong class="text-ink">transparan, terstruktur, dan benar-benar mendampingi</strong> — bukan sekadar mengambil biaya pendaftaran lalu melepas siswa begitu saja.
          </p>
          <p>
            Sejak berdiri 3 Juli 2024, HATESE telah membimbing ratusan siswa dari nol bahasa Jepang sampai siap bekerja. Alumni kami kini tersebar di berbagai kota di Jepang — dari Okinawa di selatan sampai Hokkaido di utara — di bidang food service, perawatan lansia, konstruksi, manufaktur, dan lainnya.
          </p>
          <p>
            Kami percaya: <em class="text-ink">bekerja di Jepang bukan sekadar mencari penghasilan lebih besar, tetapi tentang membangun disiplin, keterampilan, dan pola pikir yang akan berguna seumur hidup.</em>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LEGALITAS ============ -->
  <section class="bg-mist/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="max-w-2xl mb-12">
        <h2 class="font-display text-3xl lg:text-4xl font-semibold text-ink">
          Legalitas & Identitas Resmi
        </h2>
        <p class="mt-4 text-lg text-ink/70">
          Lembaga yang mengelola visa dan masa depan kerja orang harus bisa diverifikasi. Ini identitas resmi kami.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {legalitas.map((item) => (
          <div class="bg-paper border border-mist rounded-[--radius-card] p-6">
            <p class="text-xs uppercase tracking-wide text-ink/50 font-medium">
              {item.label}
            </p>
            <p class="mt-2 font-display text-base font-medium text-ink leading-snug">
              {item.value}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 3 JAMINAN ============ -->
  <section class="bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="max-w-2xl mb-12">
        <h2 class="font-display text-3xl lg:text-4xl font-semibold text-ink">
          Tiga Jaminan Kami
        </h2>
        <p class="mt-4 text-lg text-ink/70">
          Bukan janji manis — ini yang benar-benar kami berikan ke setiap siswa.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {jaminan.map((item) => {
          const IconComponent = resolveIcon(item.iconName);
          return (
            <div class="border border-mist rounded-[--radius-card] p-6 lg:p-8 hover:border-indigo transition-colors">
              <span class="inline-flex items-center justify-center w-12 h-12 rounded-[--radius-card] bg-indigo/10 text-indigo">
                <IconComponent class="w-6 h-6" stroke-width={1.75} />
              </span>
              <h3 class="mt-5 font-display text-xl font-medium text-ink">
                {item.title}
              </h3>
              <p class="mt-3 text-sm lg:text-base text-ink/70 leading-relaxed">
                {item.body}
              </p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ NILAI / VALUES ============ -->
  <section class="bg-indigo text-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="max-w-2xl mb-12">
        <h2 class="font-display text-3xl lg:text-4xl font-semibold">
          Yang Kami Pegang
        </h2>
        <p class="mt-4 text-lg text-paper/80">
          Tiga prinsip yang menentukan bagaimana kami bekerja setiap hari.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {values.map((item) => {
          const IconComponent = resolveIcon(item.iconName);
          return (
            <div class="bg-paper/5 border border-paper/10 rounded-[--radius-card] p-6 lg:p-8">
              <span class="inline-flex items-center justify-center w-12 h-12 rounded-[--radius-card] bg-gold/20 text-gold">
                <IconComponent class="w-6 h-6" stroke-width={1.75} />
              </span>
              <h3 class="mt-5 font-display text-xl font-medium text-paper">
                {item.title}
              </h3>
              <p class="mt-3 text-sm lg:text-base text-paper/75 leading-relaxed">
                {item.body}
              </p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ TIM / INSTRUKTUR ============ -->
  <section class="bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="max-w-2xl mb-12">
        <h2 class="font-display text-3xl lg:text-4xl font-semibold text-ink">
          Tim di Balik HATESE
        </h2>
        <p class="mt-4 text-lg text-ink/70">
          Orang-orang yang mendampingi siswa setiap hari — dari kelas bahasa sampai hari keberangkatan.
        </p>
      </div>

      <!-- TODO: ganti dengan data tim asli dari HATESE -->
      <!-- Sementara placeholder — silakan isi dengan nama, jabatan, dan foto asli -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { role: 'Direktur', name: '—' },
          { role: 'Kepala Instruktur Bahasa Jepang', name: '—' },
          { role: 'Koordinator Penempatan Kerja', name: '—' },
        ].map((member) => (
          <div class="bg-mist/40 border border-mist rounded-[--radius-card] p-6 text-center">
            <div class="w-20 h-20 mx-auto rounded-full bg-indigo/10 flex items-center justify-center mb-4">
              <icons.User class="w-8 h-8 text-indigo/50" stroke-width={1.5} />
            </div>
            <p class="font-display text-base font-medium text-ink">{member.name}</p>
            <p class="text-sm text-ink/60 mt-1">{member.role}</p>
          </div>
        ))}
      </div>

      <p class="mt-8 text-sm text-ink/50 italic text-center">
        Profil tim lengkap akan ditambahkan setelah data dari tim HATESE tersedia.
      </p>
    </div>
  </section>

  <!-- ============ LOKASI / PETA ============ -->
  <section class="bg-mist/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-start">

        <!-- Info kontak -->
        <div>
          <h2 class="font-display text-3xl lg:text-4xl font-semibold text-ink leading-tight">
            Kunjungi Kantor Kami
          </h2>
          <p class="mt-4 text-lg text-ink/70 max-w-[60ch]">
            Kami terbuka untuk kunjungan langsung. Silakan datang untuk konsultasi tatap muka, atau hubungi kami lewat telepon dan WhatsApp.
          </p>

          <address class="mt-8 not-italic space-y-4">
            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 w-10 h-10 rounded-[--radius-card] bg-indigo/10 text-indigo flex items-center justify-center">
                <icons.MapPin class="w-5 h-5" stroke-width={1.75} />
              </span>
              <div>
                <p class="text-xs uppercase tracking-wide text-ink/50 font-medium">Alamat</p>
                <p class="mt-1 text-ink">Kota Cirebon, Jawa Barat, Indonesia</p>
                <!-- TODO: isi alamat lengkap dari tim HATESE -->
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 w-10 h-10 rounded-[--radius-card] bg-indigo/10 text-indigo flex items-center justify-center">
                <icons.Phone class="w-5 h-5" stroke-width={1.75} />
              </span>
              <div>
                <p class="text-xs uppercase tracking-wide text-ink/50 font-medium">Telepon / WhatsApp</p>
                <a href="tel:+6281234567890" class="mt-1 text-ink hover:text-vermillion transition-colors inline-block">
                  +62 812-3456-7890
                </a>
                <!-- TODO: ganti dengan nomor WA resmi HATESE -->
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 w-10 h-10 rounded-[--radius-card] bg-indigo/10 text-indigo flex items-center justify-center">
                <icons.Mail class="w-5 h-5" stroke-width={1.75} />
              </span>
              <div>
                <p class="text-xs uppercase tracking-wide text-ink/50 font-medium">Email</p>
                <a href="mailto:info@hatese.co.id" class="mt-1 text-ink hover:text-vermillion transition-colors inline-block">
                  info@hatese.co.id
                </a>
                <!-- TODO: ganti dengan email resmi HATESE -->
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 w-10 h-10 rounded-[--radius-card] bg-indigo/10 text-indigo flex items-center justify-center">
                <icons.Clock class="w-5 h-5" stroke-width={1.75} />
              </span>
              <div>
                <p class="text-xs uppercase tracking-wide text-ink/50 font-medium">Jam Operasional</p>
                <p class="mt-1 text-ink">Senin – Sabtu, 08.00 – 17.00 WIB</p>
              </div>
            </div>
          </address>

          <div class="mt-8">
            <Button variant="primary" href={`${import.meta.env.BASE_URL}daftar`} iconRight>
              Konsultasi Sekarang
            </Button>
          </div>
        </div>

        <!-- Peta -->
        <div class="relative">
          <div class="aspect-[4/3] rounded-[--radius-card] overflow-hidden bg-mist border border-mist">
            <!-- TODO: ganti dengan embed Google Maps alamat kantor HATESE -->
            <!-- Contoh: <iframe src="https://www.google.com/maps/embed?pb=..." class="w-full h-full" ...></iframe> -->
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-indigo/10 to-mist">
              <div class="text-center">
                <icons.Map class="w-12 h-12 text-indigo/40 mx-auto" stroke-width={1.5} />
                <p class="mt-3 text-sm text-ink/60">Peta lokasi akan ditampilkan di sini</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA PENUTUP ============ -->
  <section class="bg-indigo text-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 text-center">
      <h2 class="font-display text-3xl lg:text-4xl font-semibold">
        Siap Memulai Perjalananmu?
      </h2>
      <p class="mt-4 text-lg text-paper/80 max-w-[52ch] mx-auto">
        Konsultasi gratis — tim kami akan menjelaskan alur, biaya, dan peluang yang paling cocok untukmu.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button variant="primary" href={`${import.meta.env.BASE_URL}daftar`} iconRight>
          Konsultasi Sekarang
        </Button>
        <a href={`${import.meta.env.BASE_URL}kegiatan`} class="inline-flex items-center gap-2 px-5 py-2.5 text-paper border-[1.5px] border-paper/40 rounded-[--radius-button] hover:bg-paper/10 transition-colors">
          Lihat Kegiatan Kami
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SCROLL REVEAL (fade-in ketika di-scroll) ============ -->
  <style>
    section.js-reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    section.js-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      section.js-reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script>
    function initScrollReveal() {
      const sections = document.querySelectorAll('section');
      if (!sections.length) return;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      sections.forEach((el) => el.classList.add('js-reveal'));

      if (prefersReduced || !('IntersectionObserver' in window)) {
        sections.forEach((el) => el.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );

      sections.forEach((el) => observer.observe(el));
    }

    // Jalankan saat load pertama, dan saat navigasi lewat Astro View Transitions (jika dipakai)
    initScrollReveal();
    document.addEventListener('astro:page-load', initScrollReveal);
  </script>
</BaseLayout>